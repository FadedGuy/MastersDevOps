{
  "variables": {
    "aws_region": "{{env `AWS_REGION`}}",
    "gcp_project_id": "{{env `GCP_PROJECT_ID`}}",
    "gcp_account_file": "{{env `GCP_ACCOUNT_FILE`}}",
    "ami_name": "web-app-{{timestamp}}",
    "gcp_image_name": "web-app-{{timestamp}}",
    "source_ami": "{{env `SOURCE_AMI`}}",
    "instance_type": "t2.micro",
    "ssh_username": "ubuntu",
    "subnet_id": "{{env `AWS_SUBNET_ID`}}",
    "security_group_id": "{{env `AWS_SECURITY_GROUP_ID`}}",
    "gcp_zone": "us-central1-a",
    "gcp_source_image": "ubuntu-os-cloud/ubuntu-2004-lts",
    "app_version": "1.0.0"
  },
  "builders": [
    {
      "type": "amazon-ebs",
      "region": "{{var `aws_region`}}",
      "source_ami": "{{var `source_ami`}}",
      "instance_type": "{{var `instance_type`}}",
      "ssh_username": "{{var `ssh_username`}}",
      "ami_name": "{{var `ami_name`}}",
      "subnet_id": "{{var `subnet_id`}}",
      "security_group_ids": ["{{var `security_group_id`}}"],
      "associate_public_ip_address": true,
      "tags": {
        "Name": "Web App Base AMI",
        "OS_Version": "Ubuntu 20.04",
        "Release": "Latest",
        "App_Version": "{{var `app_version`}}"
      }
    },
    {
      "type": "googlecompute",
      "project_id": "{{var `gcp_project_id`}}",
      "account_file": "{{var `gcp_account_file`}}",
      "source_image": "{{var `gcp_source_image`}}",
      "zone": "{{var `gcp_zone`}}",
      "image_name": "{{var `gcp_image_name`}}",
      "ssh_username": "{{var `ssh_username`}}"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo apt-get update -y",
        "sudo apt-get install -y nginx"
      ]
    },
    {
      "type": "file",
      "source": "files/index.html",
      "destination": "/tmp/index.html"
    },
    {
      "type": "shell",
      "script": "scripts/setup_app.sh"
    },
    {
      "type": "shell",
      "inline": [
        "sudo systemctl restart nginx"
      ]
    }
  ]
}	